{
  "name": "fks-google-calendar-widget",
  "version": "0.1.0",
  "private": true,
  "description": "Windows desktop widget for Google Calendar (Phase 1: local MVP, read-only)",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "author": "Gabriel Vidal",
  "license": "UNLICENSED",
  "dependencies": {
    "dotenv": "^16.4.5",
    "google-auth-library": "^9.14.1",
    "googleapis": "^144.0.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.gabrielvidal.fkscalendarwidget",
    "productName": "FKS Calendar Widget",
    "files": [
      "src/**/*",
      "resources/**/*",
      "package.json",
      "!**/.env"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
