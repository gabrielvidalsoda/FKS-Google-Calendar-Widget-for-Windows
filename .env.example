# OPTIONAL dev override. The app ships its OAuth "Desktop app" client in
# src/config/oauth.json, so a plain `npm start` / packaged build works with no
# .env at all. Only create a .env (copy this file to ".env", gitignored) if you
# want to point the app at a *different* Google Cloud project while developing.
# See SETUP.md.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
